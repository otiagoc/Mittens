# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Obtém o token em @BotFather no Telegram
TELEGRAM_BOT_TOKEN=...

# ─── Anthropic Managed Agents ─────────────────────────────────────────────────
# Cria o environment uma vez com: npx tsx src/db/setup-env.ts
ANTHROPIC_ENV_ID=env_...

# ─── Webhook (só em produção no Railway) ─────────────────────────────────────
# Ex: https://mittens-api.up.railway.app
WEBHOOK_URL=

# ─── Base de Dados (Turso) ────────────────────────────────────────────────────
# Em desenvolvimento: deixa vazio para usar SQLite local (local.db)
# Em produção: cria uma BD em turso.tech e preenche aqui
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000

# ─── Dashboard CRM ────────────────────────────────────────────────────────────
ADMIN_PASSWORD=mittens2024
JWT_SECRET=<random_string_seguro>
